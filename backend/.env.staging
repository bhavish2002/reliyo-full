# Local staging profile (Sprint 5) — merge with .env.staging.local for secrets
# Usage: npm run start:dev:staging

RELIYO_PROFILE=staging
NODE_ENV=staging
PORT=4000
LOG_FORMAT=json

DATABASE_URL=postgresql://reliyo:reliyo@localhost:5433/reliyo?schema=public

API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:8080

# Match .env for local dev so login survives switching start:dev ↔ start:dev:staging
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_TTL_SEC=604800
JWT_ACCESS_TTL_SEC=900

OTP_PROVIDER=dev

PAYMENT_MODE=live
PAYMENT_PSP=razorpay
PAYMENT_WEBHOOK_SECRET_MOCK=mock-webhook-secret

PUBLIC_API_URL=

# 3-strike inactivity cron (defaults on for local staging profile; set false to disable)
INACTIVITY_JOB_ENABLED=true
