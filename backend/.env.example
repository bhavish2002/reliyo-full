# Copy to .env (required for Prisma CLI) and optionally .env.local (Nest overrides):
#   cp .env.example .env
#
# Environment: development | staging | production
NODE_ENV=development
PORT=4000
LOG_FORMAT=text

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://reliyo:reliyo@localhost:5433/reliyo?schema=public

# Redis (reserved for future BullMQ / cache; not wired in Sprint 2 baseline)
REDIS_URL=

# API
API_PREFIX=api/v1

# CORS (comma-separated origins; default localhost:8080)
CORS_ORIGIN=http://localhost:8080

# JWT (change secrets in staging/production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_TTL_SEC=604800
JWT_ACCESS_TTL_SEC=900

# OTP: dev | twilio
OTP_PROVIDER=dev
# Optional fixed code in non-production for automated testing
OTP_DEV_FIXED_CODE=
# Max OTP sends per phone per hour (default: 30 dev, 5 production)
OTP_MAX_SENDS_PER_HOUR=

# Twilio (when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments (Sprint 5)
# PAYMENT_MODE: mock | live
PAYMENT_MODE=mock
# Selected PSP for Sprint 5: razorpay (webhook format abstraction supports mock + razorpay)
PAYMENT_PSP=razorpay
# Shared mock webhook secret for local testing
PAYMENT_WEBHOOK_SECRET_MOCK=mock-webhook-secret

# Razorpay (required in live mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Indian Razorpay accounts accept INR only in test/live. Set comma-separated codes when using international merchant.
RAZORPAY_SUPPORTED_CURRENCIES=INR

# Background jobs (Sprint 8A) — enable on staging/production hosts.
# Defaults to on in local dev/staging (NODE_ENV != production/test). Set false to disable hourly cron.
# INACTIVITY_JOB_ENABLED=true
WEBHOOK_RETRY_JOB_ENABLED=false

# Staging (B5): copy backend/.env.staging.example → .env.staging
# Tunnel: npm run tunnel:webhooks — see docs/sprint-5/staging-webhooks.md
PUBLIC_API_URL=
