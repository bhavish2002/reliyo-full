# Staging environment template (Sprint 5 — B5)
# Copy to .env.staging or merge into your staging host secrets manager.
#
#   cp .env.staging.example .env.staging
#
# Use with: NODE_ENV=staging and a managed Postgres (not local Docker unless tunneled).

NODE_ENV=staging
PORT=4000
LOG_FORMAT=json

# Managed Postgres (replace with your staging instance)
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:5432/reliyo?schema=public

REDIS_URL=

API_PREFIX=api/v1

# Frontend staging origin(s) — comma-separated
CORS_ORIGIN=https://staging.reliyo.example,http://localhost:8080

JWT_ACCESS_SECRET=CHANGE_ME_STAGING_ACCESS_SECRET
JWT_REFRESH_TTL_SEC=604800
JWT_ACCESS_TTL_SEC=900

# Staging OTP — use Twilio or dev with fixed code for QA only
OTP_PROVIDER=twilio
OTP_DEV_FIXED_CODE=
OTP_MAX_SENDS_PER_HOUR=10

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments — live Razorpay TEST keys on staging
PAYMENT_MODE=live
PAYMENT_PSP=razorpay
PAYMENT_WEBHOOK_SECRET_MOCK=mock-webhook-secret

RAZORPAY_KEY_ID=rzp_test_XXXX
RAZORPAY_KEY_SECRET=XXXX
RAZORPAY_WEBHOOK_SECRET=whsec_XXXX

# Public tunnel URL (set after running npm run tunnel:webhooks)
# Register in Razorpay Dashboard → Webhooks:
#   {PUBLIC_API_URL}/api/v1/payments/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid
PUBLIC_API_URL=
